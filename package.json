{
  "name": "dsh-webctl",
  "version": "0.1.0",
  "type": "module",
  "description": "DeepSeek Harness 插件：通过 MCP 暴露 webctl 全部工具，并在设置页诊断 webctl 与 Playwright 状态。",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/**/*.mjs",
    "src/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/**/*.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thatgfsj-dsh/dsh-webctl.git"
  },
  "homepage": "https://github.com/thatgfsj-dsh/dsh-webctl",
  "bugs": {
    "url": "https://github.com/thatgfsj-dsh/dsh-webctl/issues"
  },
  "private": false
}
